# ─── Database ────────────────────────────────────────────────
DATABASE_URL="postgresql://mana:mana@localhost:5433/mana?schema=public"

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── API ─────────────────────────────────────────────────────
API_PORT=4000
NODE_ENV=development
# comma-separated allowed origins for CORS
CORS_ORIGINS="http://localhost:3000"

# ─── Auth ────────────────────────────────────────────────────
JWT_SECRET="dev-change-me"
JWT_EXPIRES_IN="15m"
REFRESH_EXPIRES_IN="30d"

# ─── Verification providers (dev uses mock adapters) ─────────
# See plans/07-verification-kyc.md. Real keys required in prod.
VERIFY_PROVIDER_MODE="mock"   # mock | live
SMS_PROVIDER="mock"           # mock | msg91 | gupshup
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
MSG91_SENDER_ID=""
EMAIL_PROVIDER="mock"         # mock | resend
RESEND_API_KEY=""             # required when EMAIL_PROVIDER=resend
EMAIL_FROM="Mana <onboarding@resend.dev>"
DIGILOCKER_CLIENT_ID=""
DIGILOCKER_CLIENT_SECRET=""
DIGILOCKER_REDIRECT_URI="http://localhost:4000/onboarding/aadhaar/digilocker/callback"
KYC_PROVIDER_API_KEY=""       # set => Surepass live adapter handles PAN/GST/bank/RC/challan
KYC_PROVIDER_BASE_URL="https://kyc-api.surepass.io"

# ─── Payments (Razorpay) ─────────────────────────────────────
# Set key id + secret => live billing (payment links + webhook activation).
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""     # configure webhook -> POST /api/webhooks/razorpay

# ─── Media uploads (S3 presigned) ────────────────────────────
S3_BUCKET=""
S3_REGION="ap-south-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE=""             # e.g. https://cdn.mana.in (defaults to the bucket URL)
S3_ENDPOINT=""               # optional, for S3-compatible (R2/MinIO)

# ─── Search (OpenSearch / Elasticsearch) ─────────────────────
OPENSEARCH_URL=""             # e.g. https://search.mana.in ; unset -> Postgres search fallback
OPENSEARCH_USERNAME=""        # optional basic-auth
OPENSEARCH_PASSWORD=""

# ─── Aadhaar vault (separate encrypted store) ────────────────
AADHAAR_VAULT_KEY=""          # KMS-managed in prod; never store unmasked Aadhaar in app DB

# ─── Lender + eSign (financing) ──────────────────────────────
LENDER_API_URL=""             # unset -> local underwriting heuristic
LENDER_API_KEY=""
ESIGN_API_URL=""              # unset -> mock eSign (Digio/Leegality/NSDL)
ESIGN_API_KEY=""
ESIGN_CALLBACK_URL=""         # e.g. https://mana.in/finance/esign/callback

# ─── DigiLocker (Aadhaar consent/redirect) ───────────────────
DIGILOCKER_CLIENT_ID=""       # unset -> mock consent flow
DIGILOCKER_CLIENT_SECRET=""
DIGILOCKER_REDIRECT_URI=""    # e.g. https://mana.in/onboarding/digilocker/callback
DIGILOCKER_BASE_URL="https://digilocker.meripehchaan.gov.in"

# ─── Web ─────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"
