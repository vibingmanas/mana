{
  "name": "@mana/agent",
  "version": "0.0.0",
  "private": true,
  "description": "mana-dev — a Telegram group bot that runs Claude Code against this repo when addressed",
  "scripts": {
    "dev": "node --watch --require @swc-node/register src/index.ts",
    "start": "node --require @swc-node/register src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"(agent) lint TBD\" && exit 0",
    "test": "vitest run"
  },
  "devDependencies": {
    "@swc-node/register": "^1.10.9",
    "@swc/core": "^1.10.7",
    "@types/node": "^22.10.7",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
