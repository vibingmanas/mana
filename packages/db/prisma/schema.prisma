// Mana — Prisma schema (foundation).
// Models the core of the consolidated data model in plans/11-architecture-tech-stack.md.
// Feature PRs extend this (listings detail, bookings, finance, billing, admin queues, etc.).
// Geo stored as lat/lng floats for now; PostGIS geography column added in a later migration.

generator client {
  provider      = "prisma-client-js"
  output        = "../generated/client"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────

enum UserRole {
  BUYER
  DEALER_OWNER
  DEALER_STAFF
  INSPECTOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum DealerStatus {
  DRAFT
  IN_REVIEW
  ACTIVE
  SUSPENDED
  REJECTED
}

// Verification tiers — see plans/01-vendor-onboarding.md
enum VerificationTier {
  T0 // registered (email + phone)
  T1 // identity verified (+ aadhaar + pan)
  T2 // business verified (+ gst + bank)
  T3 // mana certified (+ premises + agreement)
}

enum CheckType {
  EMAIL
  PHONE
  AADHAAR
  PAN
  GST
  BANK
  VEHICLE_RC
  VEHICLE_CHALLAN
}

enum VerificationStatus {
  PENDING
  SUCCESS
  FAILED
  MANUAL_REVIEW
}

enum VehicleStatus {
  DRAFT
  RC_VERIFYING
  RC_VERIFIED
  RC_FAILED
  INSPECTION_PENDING
  READY
  LIVE
  RESERVED
  SOLD
  PAUSED
  EXPIRED
  REMOVED
}

enum MediaType {
  PHOTO
  THREE_SIXTY
  VIDEO
  DOC
}

enum LeadIntent {
  ENQUIRY
  TEST_DRIVE
  FINANCE
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  APPOINTMENT
  WON
  LOST
}

enum AppointmentType {
  AT_DEALER
  DOORSTEP
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  RESCHEDULED
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum InspectionType {
  PHYSICAL
  AI_PHOTO
  SELF
}

enum FraudRisk {
  LOW
  MEDIUM
  HIGH
}

enum CertificationTier {
  SELF_DECLARED
  AI_CHECKED
  MANA_INSPECTED
  MANA_CERTIFIED
}

enum FinanceStatus {
  ELIGIBILITY
  APPLIED
  APPROVED
  REJECTED
  DISBURSED
}

enum InsuranceStatus {
  QUOTED
  PURCHASED
  TRANSFERRED
}

enum RcTransferStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
}

enum CommissionSource {
  FINANCE
  INSURANCE
  RC
  FLOORPLAN
}

enum CommissionStatus {
  ACCRUED
  INVOICED
  PAID
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum InvoiceStatus {
  PAID
  DUE
  VOID
}

// ─── Identity ───────────────────────────────────────────────

model User {
  id          String     @id @default(cuid())
  role        UserRole
  phone       String     @unique
  phoneVerifiedAt DateTime?
  email       String?    @unique
  emailVerifiedAt DateTime?
  name        String?
  status      UserStatus @default(ACTIVE)
  passwordHash String?   // optional; OTP-first auth
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  dealerOwnerOf Dealer?        @relation("DealerOwner")
  buyer         Buyer?
  adminProfile  AdminUser?
  refreshTokens RefreshToken[]
  auditActions  AuditLog[]     @relation("AuditActor")
  notifications Notification[]
  sellRequests  SellRequest[]
  disputes      Dispute[]      @relation("DisputeRaiser")
  inspectorJobs InspectionJob[] @relation("InspectorJobs")
  dealerStaffOf DealerStaff[]  @relation("StaffMembership")

  @@index([role])
}

enum SellStatus {
  ESTIMATED
  INSPECTION_BOOKED
  OFFERS_READY
  ACCEPTED
  CLOSED
}

enum OfferStatus {
  OPEN
  ACCEPTED
  DECLINED
}

model SellRequest {
  id              String      @id @default(cuid())
  sellerUserId    String
  seller          User        @relation(fields: [sellerUserId], references: [id], onDelete: Cascade)
  regNumber       String?
  make            String?
  model           String?
  manufactureYear Int?
  fuelType        String?
  transmission    String?
  odometerKm      Int?
  ownersCount     Int?
  city            String?
  condition       String? // excellent | good | fair
  accidentDamage  Boolean     @default(false)
  estLow          Int
  estFair         Int
  estHigh         Int
  status          SellStatus  @default(ESTIMATED)
  inspectionAt    DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  offers          DealerOffer[]

  @@index([sellerUserId])
}

model DealerOffer {
  id            String      @id @default(cuid())
  sellRequestId String
  sellRequest   SellRequest @relation(fields: [sellRequestId], references: [id], onDelete: Cascade)
  dealerName    String
  dealerTier    String
  amount        Int
  status        OfferStatus @default(OPEN)
  createdAt     DateTime    @default(now())

  @@index([sellRequestId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // price_drop | saved_search_match | ...
  title     String
  body      String
  vehicleId String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model PriceHistory {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  price     Int
  changedAt DateTime @default(now())

  @@index([vehicleId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

// One-time passwords for phone/email verification (dev mock + real)
model OtpChallenge {
  id          String   @id @default(cuid())
  channel     String   // "phone" | "email"
  destination String
  codeHash    String
  purpose     String   // "login" | "onboarding" | ...
  attempts    Int      @default(0)
  consumedAt  DateTime?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([destination, purpose])
}

// ─── Dealer (vendor) ────────────────────────────────────────

model Dealer {
  id               String           @id @default(cuid())
  ownerUserId      String           @unique
  ownerUser        User             @relation("DealerOwner", fields: [ownerUserId], references: [id])
  legalName        String?
  displayName      String?
  ownerName        String?
  status           DealerStatus     @default(DRAFT)
  verificationTier VerificationTier @default(T0)
  city             String?
  state            String?
  address          String?
  latitude         Float?
  longitude        Float?
  premisesType     String?
  yearEstablished  Int?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  kyc                 DealerKYC?
  onboarding          OnboardingProgress?
  vehicles            Vehicle[]
  leads               Lead[]
  availability        DealerAvailability[]
  appointments        Appointment[]
  financeApplications FinanceApplication[]
  rcTransfers         RcTransferCase[]
  subscription        Subscription?
  invoices            Invoice[]
  staff               DealerStaff[]
  syndication         SyndicationTarget[]
  floorPlan           FloorPlanFacility?

  @@index([status])
  @@index([verificationTier])
}

enum DealerStaffRole {
  MANAGER
  SALES
}

// A non-owner user with scoped access to a dealer's DMS (owner manages the roster).
model DealerStaff {
  id        String          @id @default(cuid())
  dealerId  String
  dealer    Dealer          @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation("StaffMembership", fields: [userId], references: [id], onDelete: Cascade)
  role      DealerStaffRole @default(SALES)
  createdAt DateTime        @default(now())

  @@unique([dealerId, userId])
  @@index([userId])
}

enum SyndicationChannel {
  OLX
  CARWALE
  CARS24
  FACEBOOK
}

// Per-dealer toggle of which external marketplaces the live-listings feed targets.
model SyndicationTarget {
  id        String             @id @default(cuid())
  dealerId  String
  dealer    Dealer             @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  channel   SyndicationChannel
  enabled   Boolean            @default(true)
  createdAt DateTime           @default(now())

  @@unique([dealerId, channel])
}

model DealerKYC {
  id               String    @id @default(cuid())
  dealerId         String    @unique
  dealer           Dealer    @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  emailVerifiedAt  DateTime?
  phoneVerifiedAt  DateTime?
  // Aadhaar: full number NEVER stored here. Token references the Aadhaar Data Vault.
  aadhaarVaultToken String?
  aadhaarNameMasked String?
  aadhaarMethod     String?  // "digilocker" | "offline_xml"
  aadhaarVerifiedAt DateTime?
  pan              String?
  panName          String?
  panVerifiedAt    DateTime?
  gstin            String?
  gstLegalName     String?
  gstStatus        String?
  gstVerifiedAt    DateTime?
  bankAccountRef   String?
  bankName         String?
  bankAccountName  String?
  bankVerifiedAt   DateTime?
  updatedAt        DateTime  @updatedAt
}

model OnboardingProgress {
  dealerId       String   @id
  dealer         Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  currentStep    String   @default("signup")
  completedSteps String[] @default([])
  lastActiveAt   DateTime @default(now())
}

// ─── Buyer ──────────────────────────────────────────────────

model Buyer {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  city        String?
  latitude    Float?
  longitude   Float?
  preferences Json?
  createdAt   DateTime @default(now())

  leads               Lead[]
  wishlist            Wishlist[]
  savedSearches       SavedSearch[]
  appointments        Appointment[]
  financeApplications FinanceApplication[]
  insurancePolicies   InsurancePolicy[]
  rcTransfers         RcTransferCase[]
}

model Lead {
  id        String     @id @default(cuid())
  buyerId   String
  buyer     Buyer      @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  vehicleId String
  vehicle   Vehicle    @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  dealerId  String
  dealer    Dealer     @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  channel   String     @default("web")
  intent    LeadIntent @default(ENQUIRY)
  status    LeadStatus @default(NEW)
  note      String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([dealerId, status])
  @@index([buyerId])
  @@index([vehicleId])
}

model Wishlist {
  id        String   @id @default(cuid())
  buyerId   String
  buyer     Buyer    @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([buyerId, vehicleId])
}

model SavedSearch {
  id           String   @id @default(cuid())
  buyerId      String
  buyer        Buyer    @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  query        Json
  alertChannel String   @default("none") // none | push | whatsapp | email
  createdAt    DateTime @default(now())

  @@index([buyerId])
}

model Inspection {
  id              String         @id @default(cuid())
  vehicleId       String
  vehicle         Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type            InspectionType
  templateVersion String         @default("v1")
  overallScore    Int? // 0..100
  grade           String? // A | B | C | D
  sectionScores   Json?
  status          String         @default("completed")
  reportUrl       String?
  completedAt     DateTime?
  createdAt       DateTime       @default(now())

  job             InspectionJob?

  @@index([vehicleId])
}

enum InspectionJobStatus {
  REQUESTED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Scheduled physical inspection assigned to an INSPECTOR. Offline app submits
// results with a clientRef for idempotent replay over flaky field networks.
model InspectionJob {
  id                  String              @id @default(cuid())
  vehicleId           String
  vehicle             Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  requestedByUserId   String
  assignedInspectorId String?
  assignedInspector   User?               @relation("InspectorJobs", fields: [assignedInspectorId], references: [id])
  status              InspectionJobStatus @default(REQUESTED)
  scheduledAt         DateTime?
  location            String?
  notes               String?
  clientRef           String?             @unique
  inspectionId        String?             @unique
  inspection          Inspection?         @relation(fields: [inspectionId], references: [id])
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([assignedInspectorId, status])
  @@index([vehicleId])
}

model OdometerCheck {
  id          String    @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  declaredKm  Int
  estimatedKm Int
  fraudRisk   FraudRisk
  signals     Json
  checkedAt   DateTime  @default(now())

  @@index([vehicleId])
}

model Certification {
  id        String            @id @default(cuid())
  vehicleId String            @unique
  vehicle   Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  tier      CertificationTier
  issuedAt  DateTime          @default(now())
  expiresAt DateTime?
}

// ─── Financing / insurance / RC transfer (plan 09) ──────────

model FinanceApplication {
  id           String        @id @default(cuid())
  buyerId      String
  buyer        Buyer         @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  vehicleId    String
  vehicle      Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  dealerId     String
  dealer       Dealer        @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  amount       Int
  downPayment  Int           @default(0)
  tenureMonths Int
  partner      String?
  status       FinanceStatus @default(APPLIED)
  partnerRef   String?
  esignRef     String?
  esignStatus  String? // PENDING | SIGNED | DECLINED
  signedAt     DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([buyerId])
  @@index([dealerId, status])
}

enum FloorPlanStatus {
  REQUESTED
  ACTIVE
  SUSPENDED
  CLOSED
}

enum DrawdownStatus {
  OUTSTANDING
  REPAID
}

// Dealer inventory (floor-plan) financing: a lender funds stock up to a limit;
// the dealer draws down per vehicle and repays on sale (plan 09).
model FloorPlanFacility {
  id           String              @id @default(cuid())
  dealerId     String              @unique
  dealer       Dealer              @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  lender       String
  creditLimit  Int                 @default(0)
  outstanding  Int                 @default(0)
  interestApr  Float               @default(18)
  status       FloorPlanStatus     @default(REQUESTED)
  partnerRef   String?
  drawdowns    FloorPlanDrawdown[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model FloorPlanDrawdown {
  id              String            @id @default(cuid())
  facilityId      String
  facility        FloorPlanFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  vehicleId       String
  principal       Int
  interestAccrued Int               @default(0)
  status          DrawdownStatus    @default(OUTSTANDING)
  drawnAt         DateTime          @default(now())
  dueAt           DateTime?
  repaidAt        DateTime?

  @@index([facilityId, status])
}

model InsurancePolicy {
  id        String          @id @default(cuid())
  buyerId   String
  buyer     Buyer           @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  vehicleId String
  vehicle   Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  partner   String?
  premium   Int
  coverage  Json?
  status    InsuranceStatus @default(QUOTED)
  createdAt DateTime        @default(now())

  @@index([buyerId])
}

model RcTransferCase {
  id        String           @id @default(cuid())
  vehicleId String
  vehicle   Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  buyerId   String
  buyer     Buyer            @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  dealerId  String
  dealer    Dealer           @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  steps     Json
  status    RcTransferStatus @default(OPEN)
  fee       Int?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([dealerId, status])
}

model ReferralCommission {
  id         String           @id @default(cuid())
  sourceType CommissionSource
  sourceId   String
  partner    String?
  amount     Int
  status     CommissionStatus @default(ACCRUED)
  createdAt  DateTime         @default(now())

  @@index([sourceType])
  @@index([status])
}

// ─── Monetization (plan 12) ─────────────────────────────────

model SubscriptionPlan {
  id           String         @id @default(cuid())
  key          String         @unique // starter | growth | pro
  name         String
  priceMonthly Int // INR/month
  listingLimit Int // max live listings (-1 = unlimited)
  leadLimit    Int            @default(-1)
  features     Json?
  active       Boolean        @default(true)
  subscriptions Subscription[]
}

model Subscription {
  id                 String             @id @default(cuid())
  dealerId           String             @unique
  dealer             Dealer             @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  planId             String
  plan               SubscriptionPlan   @relation(fields: [planId], references: [id])
  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model Invoice {
  id          String        @id @default(cuid())
  dealerId    String
  dealer      Dealer        @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  amount      Int
  gstAmount   Int
  status      InvoiceStatus @default(PAID)
  periodStart DateTime
  periodEnd   DateTime
  issuedAt    DateTime      @default(now())

  @@index([dealerId])
}

model DealerAvailability {
  id               String   @id @default(cuid())
  dealerId         String
  dealer           Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  weekday          Int // 0=Sun .. 6=Sat
  startMinute      Int // minutes from midnight, e.g. 600 = 10:00
  endMinute        Int
  slotMinutes      Int      @default(30)
  doorstepEnabled  Boolean  @default(false)
  doorstepRadiusKm Int      @default(0)

  @@unique([dealerId, weekday])
}

model Appointment {
  id            String            @id @default(cuid())
  vehicleId     String
  vehicle       Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  dealerId      String
  dealer        Dealer            @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  buyerId       String
  buyer         Buyer             @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  leadId        String?
  type          AppointmentType   @default(AT_DEALER)
  scheduledStart DateTime
  scheduledEnd   DateTime
  status        AppointmentStatus @default(REQUESTED)
  location      Json?
  showed        Boolean?
  outcome       String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([dealerId, scheduledStart])
  @@index([buyerId])
  @@index([vehicleId, scheduledStart])
}

// ─── Vehicle / Listing ──────────────────────────────────────

model Vehicle {
  id              String        @id @default(cuid())
  dealerId        String
  dealer          Dealer        @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  regNumber       String
  regState        String?
  regYear         Int?
  make            String?
  model           String?
  variant         String?
  fuelType        String?
  transmission    String?
  bodyType        String?
  manufactureYear Int?
  odometerKm      Int?
  ownersCount     Int?
  color           String?
  price           Int?
  priceNegotiable Boolean       @default(true)
  valuationLow    Int?
  valuationFair   Int?
  valuationHigh   Int?
  dealScore       Float?
  status          VehicleStatus @default(DRAFT)
  city            String?
  latitude        Float?
  longitude       Float?
  listedAt        DateTime?
  soldAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  verification VehicleVerification?
  media               MediaAsset[]
  leads               Lead[]
  wishlistedBy        Wishlist[]
  appointments        Appointment[]
  inspections         Inspection[]
  inspectionJobs      InspectionJob[]
  odometerChecks      OdometerCheck[]
  certification       Certification?
  financeApplications FinanceApplication[]
  insurancePolicies   InsurancePolicy[]
  rcTransfers         RcTransferCase[]
  priceHistory        PriceHistory[]

  @@unique([dealerId, regNumber])
  @@index([status])
  @@index([make, model])
}

model VehicleVerification {
  id                  String    @id @default(cuid())
  vehicleId           String    @unique
  vehicle             Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  source              String?   // "vahan" | provider
  rcOwnerName         String?
  rcStatus            String?
  rcMakeModel         String?
  rcFuel              String?
  insuranceValidTill  DateTime?
  insuranceProvider   String?
  pucValidTill        DateTime?
  hypothecationActive Boolean?
  financerName        String?
  challanCount        Int?
  challanTotalAmount  Int?
  challanDetails      Json?
  confidence          Float?
  verifiedAt          DateTime?
}

model MediaAsset {
  id           String    @id @default(cuid())
  vehicleId    String
  vehicle      Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type         MediaType
  url          String
  thumbnailUrl String?
  position     Int       @default(0)
  aiTags       Json?
  capturedVia  String?   // "app" | "upload"
  createdAt    DateTime  @default(now())

  @@index([vehicleId])
}

// ─── Verification engine (shared) ───────────────────────────
// See plans/07-verification-kyc.md

model VerificationRequest {
  id              String             @id @default(cuid())
  subjectType     String             // "dealer" | "vehicle" | "user"
  subjectId       String
  checkType       CheckType
  provider        String?
  status          VerificationStatus @default(PENDING)
  idempotencyKey  String             @unique
  normalizedResult Json?
  confidence      Float?
  consentLogId    String?
  createdAt       DateTime           @default(now())
  completedAt     DateTime?

  @@index([subjectType, subjectId])
  @@index([status])
}

model ConsentLog {
  id           String   @id @default(cuid())
  subjectId    String
  purpose      String
  provider     String?
  documentType String?
  consentedAt  DateTime @default(now())
  ip           String?
  userAgent    String?
  expiresAt    DateTime? // <= 6 months for Aadhaar auth data

  @@index([subjectId])
}

// ─── Admin / audit ──────────────────────────────────────────

model AdminUser {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminRole   String   // superadmin | ops_admin | moderator | ...
  permissions Json?
  mfaEnabled  Boolean  @default(false)
  lastLoginAt DateTime?
  createdAt   DateTime @default(now())
}

enum DisputeStatus {
  OPEN
  RESOLVED
  REJECTED
}

model Dispute {
  id              String        @id @default(cuid())
  raisedByUserId  String
  raisedBy        User          @relation("DisputeRaiser", fields: [raisedByUserId], references: [id], onDelete: Cascade)
  type            String // listing | dealer | payment | other
  vehicleId       String?
  dealerId        String?
  message         String
  status          DisputeStatus @default(OPEN)
  resolution      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
}

model Blocklist {
  id            String   @id @default(cuid())
  kind          String // phone | pan | gstin | reg_number
  value         String
  reason        String?
  createdByUserId String?
  createdAt     DateTime @default(now())

  @@unique([kind, value])
}

model FeatureFlag {
  key         String   @id
  enabled     Boolean  @default(false)
  description String?
  updatedAt   DateTime @updatedAt @default(now())
}

// Append-only audit trail — see plans/06-admin-panel.md
model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id])
  action      String
  entityType  String
  entityId    String?
  before      Json?
  after       Json?
  reason      String?
  ip          String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorUserId])
}
